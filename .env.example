# Real backend (default for integration). Start BE on :8080 before npm run dev.
VITE_API_BASE_URL=http://localhost:8080/api

# Set to true only when you want MSW mocks in local dev (no backend required).
VITE_USE_MSW=false

# If backend CORS is not ready yet, use the Vite dev proxy instead:
# VITE_API_BASE_URL=/api
